{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "myai-cloudflare",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  }
}